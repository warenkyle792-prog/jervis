# Jervis configuration
# Copy to .env and load into your shell before running.
# Linux/macOS:  set -a && source .env && set +a
# Windows:      use `set NAME=value` in the terminal, or the System settings.
# NEVER commit real credentials — .env is gitignored.
# Jervis reads the process environment directly (no automatic .env loading).

# ---- Web server -------------------------------------------------------------
JERVIS_HOST=127.0.0.1
JERVIS_PORT=8765
# Set to 1 on a headless server / live preview to stop auto-opening a browser.
JERVIS_NO_BROWSER=0

# ---- Where the SQLite database lives ---------------------------------------
JARVIS_DATA_DIR=.jarvis_data

# ---- Optional AI chat -------------------------------------------------------
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.2
